# Шаблон переменных окружения для Ozonologist.
# Скопируй этот файл в .env.local и впиши реальные ключи.
# ВАЖНО: .env.local в .gitignore и на GitHub НЕ попадает. Секреты держи только там.

# OpenAI — обязателен, чтобы чат отвечал (модель gpt-5.5).
OPENAI_API_KEY=

# Ozon Seller API — нужны для живого режима (реальные данные магазина).
# Если оставить пустыми — приложение работает на мок-данных (тестовый магазин).
OZON_CLIENT_ID=
OZON_API_KEY=

# Необязательно: форсировать режим данных Ozon.
#   OZON_MOCK=true  — всегда мок-данные (даже при заданных ключах)
#   OZON_MOCK=false — всегда живой API
# Если переменной нет — режим выбирается автоматически по наличию ключей Ozon.
# OZON_MOCK=

# Ozon Performance API — для расходов на рекламу и ДРР (отдельный сервис!).
# Пока НЕ подключено: без этих ключей поля ad_spend/drr в аналитике = null («н/д»).
# Это ОТДЕЛЬНЫЕ ключи из кабинета Performance (не Seller): client_id + client_secret.
# OZON_PERFORMANCE_CLIENT_ID=
# OZON_PERFORMANCE_CLIENT_SECRET=

# Необязательно: только для Telegram-бота (npm run bot), к веб-приложению не относится.
# TELEGRAM_BOT_TOKEN=
